{
  "manifest_version": 3,
  "name": "Reviews AI — Review Replies",
  "version": "1.0.0",
  "description": "Generate professional AI replies for customer reviews on Google Business Profile.",
  "action": {
    "default_title": "Reviews AI",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://hlruprayqfnatnldrski.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://business.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  }
}
